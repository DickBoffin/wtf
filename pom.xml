<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <!-- The attribute above: without it every module's url is this one plus its own name, and the
         About window linked to github.com/DickBoffin/wtf/wtf-studio. -->
    <modelVersion>4.0.0</modelVersion>

    <name>WTF</name>
    <groupId>net.trdlo.wtf</groupId>
    <artifactId>wtf</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        Assembles cached map tiles into print-ready files for very large prints.
        See CLAUDE.md.
    </description>

    <url>https://github.com/DickBoffin/wtf</url>

    <!-- Copyleft: whoever passes WTF on passes its source on under the same terms, keeps the
         author's notices and marks a changed copy as changed - see LICENSE. -->
    <licenses>
        <license>
            <name>GPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>

    <modules>
        <!-- Order matters only for readability; Maven resolves the real order from the
             dependencies. wtf-tiles and wtf-compose must never depend on JavaFX - see
             CLAUDE.md. -->
        <module>wtf-tiles</module>
        <module>wtf-compose</module>
        <module>wtf-studio</module>
    </modules>

    <properties>
        <!-- release, not source and target: javac then compiles against Java 25's API, so a newer
             JDK building this cannot let a call to a method only it has slip through. -->
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Jackson binds record components by parameter name; without this it cannot. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The time every entry of every jar carries, so that two builds of one commit are the
             same jar, byte for byte, instead of two jars that differ in when they were made. Any
             fixed moment does; this one is when it was set, and nothing needs it to move. What the
             application says about its build is the commit it was made from (app.properties). -->
        <project.build.outputTimestamp>2026-09-25T00:00:00Z</project.build.outputTimestamp>

        <javafx.version>26.0.1</javafx.version>
        <ikonli.version>12.4.0</ikonli.version>
        <!-- 2.22.2 or newer: 2.20.0 dragged in jackson-core with WS-2026-0003 (the async parser
             ignores StreamReadConstraints.maxNumberLength, fixed in 2.21.1) and CVE-2026-68498
             (fixed in 2.22.2). Bump this property, never an individual Jackson artifact - the
             BOM below keeps databind, core and annotations on the same version, which is how
             one of them got a version nobody chose in the first place. -->
        <jackson.version>2.22.2</jackson.version>
        <junit.version>5.14.0</junit.version>
        <pdfbox.version>3.0.5</pdfbox.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.trdlo.wtf</groupId>
                <artifactId>wtf-tiles</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>net.trdlo.wtf</groupId>
                <artifactId>wtf-compose</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Imported rather than pinning jackson-databind on its own. Declaring one artifact
                 of a family leaves its siblings - jackson-core, jackson-annotations - on whatever
                 version that artifact happens to ask for, which is exactly how an unpatched
                 jackson-core arrives under a jackson-databind nobody would call old. A BOM pins
                 the whole family at once, the same way junit-bom does below. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.locationtech.jts</groupId>
                <artifactId>jts-core</artifactId>
                <version>1.20.0</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.5.32</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>26.1.0</version>
                <scope>provided</scope>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Every module gets the annotations and JUnit; neither reaches the runtime image. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 3.15.0 or newer: with an output timestamp set, the plugin takes the JDK's own
                     version out of each module-info.class, so a jar does not depend on which JDK 25
                     update built it - and 3.13.0 did that with an ASM that cannot read a Java 25
                     class, and failed every build. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- The same answers on every machine: a test that passes in Prague and
                             fails in Boston is a test of the machine. Tests about another
                             language choose it themselves. And native access for the unnamed
                             module the tests run in: the studio's call the Windows Credential
                             Manager's functions (ApiKeysTest), and the JDK would warn of it. -->
                        <argLine>-Duser.language=en -Duser.country=US --enable-native-access=ALL-UNNAMED</argLine>
                    </configuration>
                </plugin>
                <!-- The checks that need the packaged application, run by `verify` after the jars
                     are built: wtf-studio's ThirdPartyNoticesIT reads target/libs. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <!-- THIRD-PARTY.txt, the notices an installation carries, from the poms of what
                     wtf-studio ships: its execution is in that module. It reads the poms Maven has
                     already resolved and asks no repository for anything more, so a build stays
                     offline once its dependencies are there. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>2.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                    <!-- No META-INF/maven: its pom.properties is written with the building
                         machine's line separator, so a Windows jar and a Linux jar of one commit
                         differed there alone. The version the command line reads is the
                         manifest's, whose lines end the same everywhere. -->
                    <configuration>
                        <archive>
                            <addMavenDescriptor>false</addMavenDescriptor>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <!-- Named rather than left to the version of Maven that runs the build: what it
                     copies and filters is what goes into the jar. 3.3.1 is Maven 3.9's own. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                </plugin>
                <!-- Called by name on the release path and in CI – versions:set stamps a tag's
                     version, dependency:build-classpath runs the engine's command line – so a
                     version here, or each run takes whichever release is newest that day. The
                     dependency plugin also copies wtf-studio's jars into target/libs. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>2.22.0</version>
                    <configuration>
                        <!-- versions:set would move project.build.outputTimestamp to the moment
                             it runs, and each platform of a release runs it at its own moment,
                             so their jars would differ by the time inside them -->
                        <updateBuildOutputTimestampPolicy>never</updateBuildOutputTimestampPolicy>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
                <!-- Static analysis, run by every build that reaches `verify` – `mvn install`
                     included – through the execution below. Only the high-priority findings fail
                     it – the level at which SpotBugs is nearly always right – so a red build means
                     something worth reading. `mvn spotbugs:gui` browses the findings. -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.4.1</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>High</threshold>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
                <!-- The engine modules must not see JavaFX: CLAUDE.md. Declared by
                     wtf-tiles and wtf-compose, and by any engine module after them. Every scope
                     counts – a provided or test dependency on JavaFX is still the engine seeing
                     it – and the rule fails a local build, not only a CI job. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                    <executions>
                        <execution>
                            <id>no-javafx-in-the-engine</id>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <bannedDependencies>
                                        <excludes>
                                            <exclude>org.openjfx</exclude>
                                        </excludes>
                                        <message>JavaFX reached an engine module, which must build and run without it: see CLAUDE.md.</message>
                                    </bannedDependencies>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
