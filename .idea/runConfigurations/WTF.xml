<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="WtfApp" type="Application" factoryName="Application">
    <!-- The module must be wtf-studio.main, not the geo_import aggregator or wtf-studio itself:
         the tests compile with arguments the main code does not, so IntelliJ imports the module
         as .main and .test, and the bare wtf-studio has neither the main class nor JavaFX.
         No API key here – the GUI reads keys from Prefs (the Providers dialog), never from the
         environment, and a run configuration is a file that gets committed. -->
    <option name="MAIN_CLASS_NAME" value="net.trdlo.wtf.studio.WtfApp" />
    <module name="wtf-studio.main" />
    <option name="VM_PARAMETERS" value="--enable-native-access=javafx.graphics,net.trdlo.wtf.studio" />
    <extension name="coverage">
      <pattern>
        <option name="PATTERN" value="net.trdlo.wtf.*" />
        <option name="ENABLED" value="true" />
      </pattern>
    </extension>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
